#!/usr/bin/env bash
# Print this checkout's operator credential, minting one on first use.
#
# It lives under .devbox/, which is gitignored, so a development credential is
# never a value anybody has to remember not to commit. A deployment sets
# WIMM_OPERATOR_CREDENTIAL itself and never reaches this.
set -euo pipefail

: "${DEVBOX_PROJECT_ROOT:?run this inside the devbox shell}"
file="$DEVBOX_PROJECT_ROOT/.devbox/virtenv/wimm/operator-credential"

if [ ! -s "$file" ]; then
  mkdir -p "$(dirname "$file")"
  umask 077
  head -c 32 /dev/urandom | base64 | tr -d '\n=' | tr '/+' '_-' > "$file"
fi

cat "$file"
