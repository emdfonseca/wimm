#!/usr/bin/env bash
# Run an execute snippet against a .pen file, headless: bin/pen-exec <file.pen> [snippet-file]
# Reads the snippet from stdin when no file is given.
#
# Headless is the way journeys are drawn. `pen interactive --in X --out X` really
# opens X, resolves its imports, and writes it on exit — no app, no person.
#
# The pencil MCP cannot do this. It ignores its filePath argument and acts on
# whatever document Pen.app has open, silently, so an MCP edit aimed at a journey
# lands in the library instead. Use the MCP only for the document a person is
# looking at, and never on a file this script owns.
set -euo pipefail

file="${1:-}"
if [ -z "$file" ]; then
  echo "usage: bin/pen-exec <file.pen> [snippet-file]" >&2
  exit 2
fi
if [ ! -f "$file" ]; then
  echo "pen-exec: no such file: $file (create it with bin/pen-import)" >&2
  exit 1
fi

snippet="$(cat "${2:-/dev/stdin}")"
if [ -z "${snippet//[[:space:]]/}" ]; then
  echo "pen-exec: empty snippet" >&2
  exit 2
fi

# The renderer fetches webfonts over the network. Node's fetch ignores the proxy
# environment unless told, and a font that does not arrive does not error — text
# collapses, every text-driven height measures short, and a layout check reports
# a clean pass over a canvas that overlaps on screen.
export NODE_USE_ENV_PROXY=1
[ -n "${NIX_SSL_CERT_FILE:-}" ] && export NODE_EXTRA_CA_CERTS="${NODE_EXTRA_CA_CERTS:-$NIX_SSL_CERT_FILE}"

# A snapshot to restore from. `pen interactive` applies operations one at a
# time and the piped `save()` runs whatever happened before an error, so a
# snippet that fails part way through leaves the file partly rewritten. The
# guarantee ADR 0011 states — a failed snippet leaves the file byte-identical —
# is this backup, not something the CLI does.
backup="$(mktemp "${TMPDIR:-/tmp}/pen-exec.XXXXXX")"
cp "$file" "$backup"
trap 'rm -f "$backup"' EXIT

# The command that actually drives pen. Overridable so the shim's own failure
# handling can be tested against a stub that writes and then errors, which is
# the case that matters and the one the real CLI is slow and online to produce.
# Nothing but the test sets it.
runner=(npm exec -y --package="@pen.dev/cli@0.3.7" -- pen interactive --in "$file" --out "$file")
if [ -n "${PEN_EXEC_RUNNER:-}" ]; then
  runner=("$PEN_EXEC_RUNNER" "$file")
fi

out="$(printf '%s\n' "$snippet" \
  | python3 -c 'import json,sys; print("execute({ input: " + json.dumps(sys.stdin.read()) + " })"); print("save()"); print("exit()")' \
  | "${runner[@]}" 2>&1)"

printf '%s\n' "$out" | grep -vE '^[[:space:]]*$|Interactive Shell|Type tool calls|Type save\(\)|Goodbye|^\[INFO\]|^[[:space:]]+at |node_modules/@pen\.dev'

if printf '%s' "$out" | grep -qiE 'failed to execute operation|Errors in the input code|Invalid properties'; then
  # Restore rather than assert: the operations before the failure have already
  # been written and saved. A tool that writes garbage and then exits non-zero
  # has still corrupted the artifact.
  if ! cmp -s "$file" "$backup"; then
    cp "$backup" "$file"
    echo "pen-exec: execute reported errors; the file was partly rewritten and has been restored" >&2
  else
    echo "pen-exec: execute reported errors; nothing was written" >&2
  fi
  exit 1
fi

# A missing font is not cosmetic: it silently shortens every text-driven height,
# so bounds read in this run describe a layout nobody will see. Fail loudly.
if printf '%s' "$out" | grep -qiE 'Failed to load font|AssetFetchError'; then
  echo "pen-exec: an asset did not load; measurements from this run are not trustworthy" >&2
  exit 1
fi
