#!/usr/bin/env bash
# Regression tests for bin/pen-exec's failure handling.
#
# The defect these exist for: `pen interactive` applies operations one at a
# time, and the `save()` piped after them writes whatever succeeded before an
# error. A snippet that failed part way through therefore left the file partly
# rewritten while the shim reported "nothing was written" — once deleting 928
# lines of a journey that way.
#
# ADR 0011 states that a failed snippet leaves the file byte-identical. These
# assert it, against a stub runner rather than the real CLI: it is the shim's
# handling under test, and a test that needed the network would stop being run.
#
# Each case asserts two things, not one: the run failed, AND the file was not
# modified. A tool that writes garbage and then exits non-zero has still
# corrupted the artifact.
set -euo pipefail

cd "$(dirname "$0")/.."
# TMPDIR when set (a sandboxed run has one it can write to), the system
# default otherwise.
tmp="$(mktemp -d "${TMPDIR:-/tmp}/pen-exec-test.XXXXXX")"
trap 'rm -rf "$tmp"' EXIT

pass=0
fail=0

# stub writes a runner that corrupts the file it is given, then prints $1.
stub() {
  local message="$1" path="$tmp/runner.sh"
  cat > "$path" <<STUB
#!/usr/bin/env bash
cat > /dev/null
printf '%s\n' "corrupted" > "\$1"
printf '%s\n' '$message'
STUB
  chmod +x "$path"
  printf '%s' "$path"
}

check() {
  local name="$1" expected_exit="$2" runner="$3" want_unchanged="$4"

  local doc="$tmp/doc.pen"
  printf '%s\n' '{"version":1,"children":[]}' > "$doc"
  local before
  before="$(md5 -q "$doc" 2>/dev/null || md5sum "$doc" | cut -d' ' -f1)"

  set +e
  PEN_EXEC_RUNNER="$runner" bin/pen-exec "$doc" <<< 'Update("x", {})' > "$tmp/out" 2>&1
  local got_exit=$?
  set -e

  local after
  after="$(md5 -q "$doc" 2>/dev/null || md5sum "$doc" | cut -d' ' -f1)"

  local problem=""
  if [ "$expected_exit" = "nonzero" ] && [ "$got_exit" -eq 0 ]; then
    problem="exited 0, want non-zero"
  elif [ "$expected_exit" = "zero" ] && [ "$got_exit" -ne 0 ]; then
    problem="exited $got_exit, want 0"
  elif [ "$want_unchanged" = "unchanged" ] && [ "$before" != "$after" ]; then
    problem="the file was modified by a failing run"
  elif [ "$want_unchanged" = "changed" ] && [ "$before" = "$after" ]; then
    problem="the file was not written by a succeeding run"
  fi

  if [ -n "$problem" ]; then
    printf '  FAIL  %-44s %s\n' "$name" "$problem" >&2
    sed 's/^/        /' "$tmp/out" >&2
    fail=$((fail + 1))
  else
    printf '  ok    %s\n' "$name"
    pass=$((pass + 1))
  fi
}

# The three error strings the shim recognises, each from a runner that has
# already written to the file.
check "a failed operation is rolled back" nonzero \
  "$(stub 'failed to execute operation: Update')" unchanged
check "invalid properties are rolled back" nonzero \
  "$(stub 'Invalid properties:')" unchanged
check "errors in the input code are rolled back" nonzero \
  "$(stub 'Errors in the input code')" unchanged

# An asset that did not load makes every measurement untrustworthy, so the run
# fails — the write itself was legitimate and is left alone.
check "a missing font fails the run" nonzero \
  "$(stub 'Failed to load font Inter')" changed

# And the case that must keep working: a clean run writes.
clean="$tmp/clean.sh"
cat > "$clean" <<'STUB'
#!/usr/bin/env bash
cat > /dev/null
printf '%s\n' "written" > "$1"
printf '%s\n' "Saved $1"
STUB
chmod +x "$clean"
check "a clean run writes the file" zero "$clean" changed

printf '\n%d passed, %d failed\n' "$pass" "$fail"
[ "$fail" -eq 0 ]
