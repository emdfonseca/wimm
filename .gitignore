# Claude Code per-machine state (config dir selected by .envrc).
# The harness itself is tracked: CLAUDE.md and settings.json below.
.claude-home/*
!.claude-home/CLAUDE.md
!.claude-home/settings.json
.claude/plans/
.claude/settings.local.json

.devbox/
node_modules/

# Per-machine environment, read by devbox via env_from. Holds paths to key
# files and one gateway application id — no key material, and still not
# something to commit.
local.env
dist/
__pycache__/

# Review reports and evidence. Machine-written, never an input to a build.
.artifacts/

# process-compose state. The database lives under .devbox/, already ignored.
.process-compose.pid

.svelte-kit/
build/
