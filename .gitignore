# Per-person agent harness: config, hooks, plans, an isolated config dir.
# The engineering standards under .claude/rules/ and .claude/skills/ are tracked.
.claude-home/
.claude/settings.json
.claude/settings.local.json
.claude/hooks/
.claude/statusline.sh
.claude/plans/
.envrc
.mcp.json
.agents/
.scratch/
.opencode/
.specify/
skills-lock.json

.devbox/
node_modules/

# Per-machine environment, read by devbox via env_from. Holds paths to key
# files and one gateway application id — no key material, and still not
# something to commit.
local.env
dist/
__pycache__/

# Review reports and evidence. Machine-written, never an input to a build.
.artifacts/

# process-compose state. The database lives under .devbox/, already ignored.
.process-compose.pid

.svelte-kit/
build/

# macOS folder metadata.
.DS_Store

# What Vitest's browser mode leaves behind when a test fails: a screenshot of
# the page and the run's attachments. Evidence for one run, never an input.
__screenshots__/
.vitest-attachments/
