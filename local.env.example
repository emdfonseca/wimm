# Per-machine configuration. Copy to `local.env`, which is gitignored:
#
#     cp local.env.example local.env
#
# The devbox shell sources it first, so anything set here wins over the
# defaults in devbox.json. Absent, everything below simply stays unset and wimm
# runs with banking disabled.

# Which open-banking adapter. Unset disables connecting entirely: Overview
# shows its empty state and wimmd registers no banking surface at all.
WIMM_BANKING_GATEWAY=enablebanking

# The application registered in the gateway's control panel.
WIMM_ENABLEBANKING_APPLICATION_ID=

# Paths, never the key material — a key in an environment variable reaches
# every child process and every crash report. Both files must be readable by
# their owner alone (chmod 600) or wimmd refuses to start.
#
# The signing key is the RSA key whose public half is uploaded to the gateway.
WIMM_ENABLEBANKING_PRIVATE_KEY=

# The sealing keys, as lines of "<key-id> <base64 of 32 bytes>". The first line
# seals new values; the rest only open old ones. Create one with:
#
#     python3 -c "import base64,os; print('2026-01', base64.b64encode(os.urandom(32)).decode())" \
#       > ~/.config/wimm/sealing.key && chmod 600 ~/.config/wimm/sealing.key
WIMM_BANKING_ENCRYPTION_KEY=

# Must match a redirect registered with the gateway, and must be a route this
# app actually serves — the return handler is at /connect/return.
#
# https, even on localhost: Enable Banking requires it. Issue a locally-trusted
# certificate with `just dev-cert`, which the dev server picks up automatically.
WIMM_ENABLEBANKING_REDIRECT_URL=https://localhost:9466/connect/return

# WIMM_BASE_URL and WIMM_ORIGINS are deliberately absent.
#
# Serving https changes the origin and WebAuthn validates it, so those two have
# to agree with whether the dev server is serving TLS. devbox derives both from
# whether `.devbox/certs/localhost.pem` exists — the same fact vite reads — so
# there is nothing here to keep in sync. Set them only to point at something
# other than this checkout's dev server.
#
# Existing passkeys survive the switch: the relying-party identifier stays
# `localhost`, and that is the value ADR 0016 calls a one-way door.
