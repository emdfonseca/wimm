{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.13.7/.schema/devbox.schema.json",
  "packages": [
    "go@1.27",
    "nodejs@26",
    "pnpm@11",
    "uv@0.12",
    "just@1.58",
    "golangci-lint@2.13",
    "buf@1.72",
    "protoc-gen-go@1.36.12",
    "protoc-gen-connect-go@1.20.0",
    "goose@3.27",
    "postgresql@18",
    "python@3.14"
  ],
  "shell": {
    "init_hook": [
      "export GOFLAGS=-mod=readonly",
      "export PATH=\"$DEVBOX_PROJECT_ROOT/bin:$PATH\"",
      "# One port block for this project, so two checkouts never fight. 9466 is",
      "# \"wimm\" on a keypad; it is deliberately nowhere near 5173, 8080 or 3000,",
      "# because a port one transposition from a framework default gets mistyped.",
      "# Postgres claims no port at all: it listens on a Unix socket (bin/db).",
      "export WIMM_WEB_PORT=\"${WIMM_WEB_PORT:-9466}\"",
      "export WIMM_STORYBOOK_PORT=\"${WIMM_STORYBOOK_PORT:-9469}\"",
      "export WIMM_PUBLIC_ADDR=\"${WIMM_PUBLIC_ADDR:-127.0.0.1:9467}\"",
      "export WIMM_OPERATOR_ADDR=\"${WIMM_OPERATOR_ADDR:-127.0.0.1:9468}\"",
      "export WIMM_BASE_URL=\"${WIMM_BASE_URL:-http://localhost:9466}\"",
      "export WIMM_DATABASE_URL=\"${WIMM_DATABASE_URL:-postgres:///wimm?host=$PGHOST&port=${PGPORT:-5432}&sslmode=disable}\"",
      "# A per-checkout operator credential, minted into .devbox on first use.",
      "export WIMM_OPERATOR_CREDENTIAL=\"${WIMM_OPERATOR_CREDENTIAL:-$(\"$DEVBOX_PROJECT_ROOT/bin/dev-credential\")}\""
    ],
    "scripts": {}
  }
}
