        {
          "type": "frame",
          "id": "ogHQD",
          "name": "J06.A · Restore access to a bank · PRIMARY SUCCESS",
          "layout": "vertical",
          "gap": 16,
          "children": [
            {
              "type": "text",
              "id": "jxQKK",
              "name": "Path label",
              "fill": "$ui:color-text-primary",
              "content": "J06.A · Restore access to a bank · PRIMARY SUCCESS",
              "fontFamily": "$ui:type-family-body",
