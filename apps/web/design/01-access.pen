      "children": [
        {
          "type": "text",
          "id": "inEp4",
          "name": "Zone label",
          "fill": "$ui:color-text-primary",
          "content": "90 · TEMPORARY NOTES",
          "fontFamily": "$ui:type-family-display",
          "fontSize": 28,
          "fontWeight": "bold"
        },
        {
          "type": "text",
          "id": "CB8Rz",
          "name": "Note",
          "fill": "$ui:color-text-secondary",
          "textGrowth": "fixed-width",
          "width": 1240,
          "content": "Medium and Ultra follow the Wide shell. Both auth pages are one centred card on an empty canvas, so a wider viewport changes nothing structurally; only the signed-in landing has a sidebar, and it is already drawn at Wide. Draw them only when a regime earns a structural difference.",
          "fontFamily": "$ui:type-family-body",
          "fontSize": 14,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "afMnU",
          "name": "Note",
          "fill": "$ui:color-text-secondary",
          "textGrowth": "fixed-width",
          "width": 1240,
          "content": "The passkey prompt is native browser chrome. It cannot be drawn, styled or positioned, and nothing on the canvas controls it. 02 · Creating passkey shows only what wimm renders while the prompt is up.",
          "fontFamily": "$ui:type-family-body",
          "fontSize": 14,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "i6VDH",
          "name": "Note",
          "fill": "$ui:color-text-secondary",
          "textGrowth": "fixed-width",
          "width": 1240,
          "content": "Arrows and state frames here establish no routing, focus order or announcements. Everything behavioural is written as a contract in canvas.md and verified in code.",
          "fontFamily": "$ui:type-family-body",
          "fontSize": 14,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "SI7t2",
