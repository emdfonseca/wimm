              ],
              "children": [
                {
                  "type": "text",
                  "id": "smQS6",
                  "name": "Title",
                  "fill": "$color-feedback-info",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "prefers-reduced-motion is not a downgrade",
                  "fontFamily": "$type-family-body",
                  "fontSize": 12,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "G4w5oZ",
                  "name": "Body",
                  "fill": "$color-text-primary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Under reduced motion every duration collapses to 0 and the skeleton shimmer holds still at its mid tone. Nothing is removed and no state becomes unreachable — a drawer still opens, it simply is open. Anything that only communicates through movement is a bug, because it communicates nothing to the user who turned movement off.",
                  "lineHeight": 1.5,
                  "fontFamily": "$type-family-body",
                  "fontSize": 11,
                  "fontWeight": "normal"
                }
              ]
            }
          ]
        }
