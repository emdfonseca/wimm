                      "fontSize": "$type-size-body-md",
                      "fontWeight": "500"
                    },
                    {
                      "type": "text",
                      "id": "ltOgK",
                      "name": "Naming",
                      "fill": "$color-text-secondary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Names are kebab-case and map 1:1 to CSS custom properties: color-bg-canvas → --color-bg-canvas. This is the one documented deviation from the pen-design standard's dotted vocabulary; roles and structure are unchanged.",
                      "lineHeight": 1.55,
                      "fontFamily": "$type-family-body",
                      "fontSize": "$type-size-body-md",
                      "fontWeight": "normal"
                    },
                    {
                      "type": "frame",
                      "id": "XtcZM",
                      "name": "Tool limitation",
                      "width": "fill_container",
                      "fill": "$color-feedback-warning-bg",
                      "cornerRadius": "$radius-md",
                      "layout": "vertical",
                      "gap": 6,
                      "padding": [
                        14,
                        16
                      ],
                      "children": [
                        {
                          "type": "text",
                          "id": "X8lN4",
                          "name": "Title",
                          "fill": "$color-feedback-warning",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Sizing tokens are a code contract, not a canvas binding",
                          "fontFamily": "$type-family-body",
                          "fontSize": 12,
                          "fontWeight": "600"
                        },
                        {
                          "type": "text",
                          "id": "Ptzv0",
                          "name": "Body",
                          "fill": "$color-text-primary",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "This pen build silently drops variable references on width and height — the property is discarded and the frame falls back to hugging its content. Every size on this canvas is therefore a literal that matches its token: control-height-md is drawn as 40, layout-sidebar-width as 264. Colour, padding, corner radius, stroke width and type size all bind normally. In code the tokens are authoritative; if a drawn size and its token disagree, the token wins.",
                          "lineHeight": 1.5,
                          "fontFamily": "$type-family-body",
                          "fontSize": 11,
                          "fontWeight": "normal"
                        }
                      ]
                    }
                  ]
                },
