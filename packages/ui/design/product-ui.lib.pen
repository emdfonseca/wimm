                  ],
                  "children": [
                    {
                      "type": "text",
                      "id": "nC8RD",
                      "name": "Title",
                      "fill": "$color-feedback-error",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "A subsection list is never a second sidebar",
                      "fontFamily": "$type-family-body",
                      "fontSize": 12,
                      "fontWeight": "600"
                    },
                    {
                      "type": "text",
                      "id": "xazBZ",
                      "name": "Body",
                      "fill": "$color-text-primary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Two objections, and the second is the one that decides it. The arithmetic: 288 + 220 + 400 leaves 1012 px of a 1920 screen for what you came to read, against 1176 in the Wide shell at 1440 — one persistent pane per side, left for navigation and right for the record. The hierarchy: Settings owns its subsections, so they belong under the page header that names Settings. A full-height column starting above that header claims they are a peer of Accounts and Transactions, which they are not.",
                      "lineHeight": 1.55,
                      "fontFamily": "$type-family-body",
                      "fontSize": 11,
                      "fontWeight": "normal"
                    }
                  ]
                }
              ]
            }
