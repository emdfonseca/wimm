                {
                  "type": "text",
                  "id": "I6XUEd",
                  "name": "Test2",
                  "fill": "$color-text-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Yes → it is a top-level destination, and every other route to it is a filtered view.\nNo → it is genuinely nested, and it lives under its parent with breadcrumbs that say so.",
