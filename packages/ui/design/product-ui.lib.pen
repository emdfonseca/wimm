            {
              "type": "frame",
              "id": "n1jtX",
              "name": "Axis interaction",
              "width": "fill_container",
              "fill": "$color-feedback-warning-bg",
              "cornerRadius": "$radius-md",
              "layout": "vertical",
              "gap": 6,
              "padding": [
                14,
                16
              ],
              "children": [
                {
                  "type": "text",
                  "id": "EYjEM",
                  "name": "Title",
                  "fill": "$color-feedback-warning",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "density = compact is never honoured where the pointer is coarse",
                  "fontFamily": "$type-family-body",
                  "fontSize": 12,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "Na51U",
                  "name": "Body",
                  "fill": "$color-text-primary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "The two axes are independent in the variable system but not in the product. A 40 px row is a comfortable pointer target and a poor thumb target, so where the pointer is coarse the density values revert to comfortable whatever the setting says, and the control that sets them is hidden rather than shown disabled.\n\nThis is keyed to input capability, not to width. A large tablet is a wide viewport with coarse input and a narrow desktop window is the reverse, so a breakpoint gets both backwards. Layout regimes stay width-driven — that is what they describe — and the target floor does not. Recorded in ADR 0004.",
                  "lineHeight": 1.5,
                  "fontFamily": "$type-family-body",
                  "fontSize": 11,
                  "fontWeight": "normal"
                }
              ]
            },
