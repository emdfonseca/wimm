            },
            {
              "type": "text",
              "id": "u9HCvC",
              "name": "Intro",
              "fill": "$color-text-secondary",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "pen.dev has no variant properties. A component is one object tree, and every difference between two instances is an override on a specific child. That single mechanic decides how this library is shaped and how you use it.",
              "lineHeight": 1.55,
              "fontFamily": "$type-family-body",
              "fontSize": "$type-size-body-md",
              "fontWeight": "normal"
