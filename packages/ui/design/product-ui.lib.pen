          "children": [
            {
              "type": "text",
              "id": "LXAcJ",
              "name": "Title",
              "fill": "$color-text-primary",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Navigation depth — when a resource appears at more than one level",
              "fontFamily": "$type-family-body",
              "fontSize": "$type-size-body-lg",
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "jfdDM",
              "name": "Note",
              "fill": "$color-text-secondary",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Transactions are a top-level destination. They are also reachable from an account, from a category, and from a budget. Left alone this produces four routes to one list, four empty states, four sets of filters, and breadcrumbs that disagree about where you are. One rule prevents all of it.",
              "lineHeight": 1.5,
              "fontFamily": "$type-family-body",
              "fontSize": "$type-size-body-sm",
              "fontWeight": "normal"
            },
            {
              "type": "frame",
              "id": "klRge",
              "name": "Rule",
              "width": "fill_container",
              "fill": "$color-accent-subtle",
              "cornerRadius": "$radius-md",
              "layout": "vertical",
              "gap": 7,
              "padding": [
                16,
                18
              ],
              "children": [
                {
                  "type": "text",
                  "id": "k03v3",
                  "name": "Title",
                  "fill": "$color-text-primary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Every resource has exactly one home",
                  "fontFamily": "$type-family-body",
                  "fontSize": 13,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "g3MInt",
                  "name": "Body",
                  "fill": "$color-text-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Everywhere else it appears, it is the same page filtered — not a second copy with its own hierarchy. An account's transactions are the Transactions page with an account filter applied, visible and removable. They are not a separate list living under the account.",
                  "lineHeight": 1.5,
                  "fontFamily": "$type-family-body",
                  "fontSize": 12,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "hSgB1",
                  "name": "Test",
                  "fill": "$color-text-primary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "The test: can this resource be listed and acted on without naming a parent?",
                  "fontFamily": "$type-family-body",
                  "fontSize": 12,
                  "fontWeight": "600"
