                  "type": "text",
                  "id": "X9byY",
                  "name": "Contract",
                  "fill": "$color-text-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "The mark never carries the hit area — each of these sits inside a row target of at least control-target-min. Hover deepens the border on an unselected mark and the fill on a selected one. Focus is the same ring as every other control; its radius follows the mark, so it is round on a radio and rounded-square on a checkbox.",
                  "lineHeight": 1.45,
                  "fontFamily": "$type-family-body",
                  "fontSize": "$type-size-body-sm",
                  "fontWeight": "normal"
                }
