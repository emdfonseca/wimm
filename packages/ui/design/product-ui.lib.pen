                  ],
                  "children": [
                    {
                      "type": "text",
                      "id": "dIMMo",
                      "name": "Title",
                      "fill": "$color-text-primary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Density is absent on touch, not disabled",
                      "fontFamily": "$type-family-body",
                      "fontSize": 12,
                      "fontWeight": "600"
                    },
                    {
                      "type": "text",
                      "id": "vJRcD",
                      "name": "Body",
                      "fill": "$color-text-secondary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Where the pointer is coarse, the density group does not render. A 40px row is a fine mouse target and a poor thumb target, so compact density is not offered there — and a control shown greyed out invites someone to work out how to enable it, which is worse than the setting not existing. This is keyed to input capability rather than width: a large tablet is a wide viewport with coarse input, and a narrow desktop window is the reverse. Appearance and sign out are unconditional.",
                      "lineHeight": 1.55,
                      "fontFamily": "$type-family-body",
                      "fontSize": 11,
                      "fontWeight": "normal"
                    }
                  ]
                }
              ]
            }
          ]
