          "width": "fill_container",
          "layout": "vertical",
          "gap": 8,
          "children": [
            {
              "type": "text",
              "id": "t1kQG",
              "name": "Eyebrow",
              "fill": "$color-text-secondary",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "30 · MOLECULES",
              "fontFamily": "$type-family-mono",
