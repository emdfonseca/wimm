              ],
              "children": [
                {
                  "type": "text",
                  "id": "GaVJ0",
                  "name": "Title",
                  "fill": "$color-text-primary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "What this changes about the target-size rule",
                  "fontFamily": "$type-family-body",
                  "fontSize": 12,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "B2zaO",
                  "name": "Body",
                  "fill": "$color-text-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "The earlier contract said a 20 px checkbox is fine because the row is its target. That was wrong in one direction: the row is not the checkbox's target, it is the *name's*. The checkbox needs its own hit area of at least control-target-min, achieved with padding around the mark rather than by growing the mark.\n\nSo the row carries three separate targets, and the spacing exception under SC 2.5.8 is what keeps them from interfering: 24 px circles centred on each must not intersect. At density = compact that is the constraint to check first, and it is why compact density is not offered where the pointer is coarse.",
                  "lineHeight": 1.55,
                  "fontFamily": "$type-family-body",
                  "fontSize": 11,
                  "fontWeight": "normal"
                }
              ]
            }
