# devbox owns the toolchain: go, node, pnpm, just, buf, goose, uv, python.
eval "$(devbox generate direnv --print-envrc)"

# Isolate Claude Code from ~/.claude for this repo: skills, agents, commands,
# plugins, rules, memory and settings all resolve under .claude-home/ instead.
# Project config in .claude/ still applies. Run `direnv allow` once.
export CLAUDE_CONFIG_DIR="$PWD/.claude-home"
